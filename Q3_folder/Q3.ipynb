## Training subset sizes

To investigate the effect of dataset size, the neural network is trained using
increasingly large subsets of the training data. The selected subset sizes span
from very small samples to the full available training set, allowing both the
low-data and high-data regimes to be explored.


class SimpleMLP(nn.Module):
    def __init__(self, input_dim: int, hidden_dim: int, output_dim: int):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, output_dim)
        )

    def forward(self, x):
        return self.net(x)

input_dim = X_train_full.shape[1]
output_dim = len(le.classes_)
hidden_dim = 64


def train_and_evaluate(
    X_train_sub,
    y_train_sub,
    X_val,
    y_val,
    X_test,
    y_test,
    n_epochs: int = 15,
    batch_size: int = 256,
    lr: float = 1e-3
):
    model = SimpleMLP(input_dim, hidden_dim, output_dim)

    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=lr)

    train_ds = TensorDataset(X_train_sub, y_train_sub)
    val_ds = TensorDataset(X_val, y_val)

    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)
    val_loader = DataLoader(val_ds, batch_size=batch_size, shuffle=False)

    for epoch in range(n_epochs):
        model.train()
        for xb, yb in train_loader:
            optimizer.zero_grad()
            outputs = model(xb)
            loss = criterion(outputs, yb)
            loss.backward()
            optimizer.step()

    # Final test evaluation
    model.eval()
    with torch.no_grad():
        outputs = model(X_test)
        _, preds = torch.max(outputs, 1)
        test_acc = (preds == y_test).float().mean().item()

    return test_acc


## Repeated training procedure

For each training subset size, a new neural network is initialised and trained
from scratch using the same architecture and hyperparameters. This ensures that
results are not influenced by weight carry-over between experiments.

def get_subset(X, y, n_samples, seed=42):
    rng = np.random.default_rng(seed)
    idx = rng.choice(len(X), size=n_samples, replace=False)
    return X[idx], y[idx]

